---
import { SITE } from "../config";
---

<section class="wrap py-20">
  <h2 class="display text-[clamp(2.2rem,6vw,4.5rem)]">
    Keep the cedi on the face.
  </h2>
  <p class="section-copy mt-6">
    We walk through your inventory, try to book a face that is already sold, and show
    you the page your clients would open. No signup on this site.
  </p>
  <p class="mt-8">
    <a class="cta cta-amber" href={SITE.walkthroughMailto}>Book a walkthrough</a>
  </p>
</section>
