---
import { SITE } from "../config";
---

<footer class="mt-24 border-t border-[var(--color-rule)] py-10">
  <div class="wrap flex flex-col gap-4 sm:flex-row sm:items-end sm:justify-between">
    <p class="wordmark m-0">{SITE.name}</p>
    <p class="m-0">{SITE.contactEmail}</p>
  </div>
  <p class="wrap mt-6 text-sm">
    Set in Archivo and Spline Sans Mono.
    <a class="plain" href={SITE.availabilityPath}>Availability</a>
    ·
    <a class="plain" href={SITE.loginPath}>Staff login</a>
    ·
    <a class="plain" href={SITE.github}>Source</a>
  </p>
</footer>
